{
  "name": "opencode-token-speed-counter",
  "version": "0.1.0",
  "description": "Live token speed pill for OpenCode Desktop 2.2.1",
  "type": "module",
  "private": true,
  "engines": { "node": ">=24" },
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=browser --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package",
    "test:package": "node --conditions=browser scripts/check-package.mjs"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.1",
    "@types/node": "24.12.2",
    "solid-js": "1.9.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.2.1"
  }
}
